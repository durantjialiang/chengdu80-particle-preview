{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:particle-preview",
  "outputDirectory": "out/particle-preview",
  "redirects": [
    {
      "source": "/history/2025/",
      "destination": "/history/",
      "permanent": true
    },
    {
      "source": "/history/2025/:path*",
      "destination": "/history/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
